cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED TOOL OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "Missing TOOL or TEST_ROOT")
endif()
# A fresh child directory on every run. No cleanup of arbitrary paths.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(project "${TEST_ROOT}/run-${suffix}")
file(MAKE_DIRECTORY "${project}/Assets/Sprites/nested")
file(WRITE "${project}/CMakeLists.txt" "# Test fixture\n")
file(WRITE "${project}/project.config" "{\"sprite\":{\"width\":16}}")
# Generator identifies names; PNG decoding is the runtime importer's job.
file(WRITE "${project}/Assets/Sprites/nested/s_tree.png" "")
file(WRITE "${project}/Assets/Sprites/plain.png" "")
file(WRITE "${project}/Assets/Sprites/anim_preserve.png" "")
file(WRITE "${project}/Assets/Sprites/anim_preserve.config" "invalid-but-owned")
execute_process(COMMAND "${TOOL}" "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Generator failed: ${result}")
endif()
set(config "${project}/Assets/Sprites/nested/s_tree.config")
file(READ "${config}" first)
string(JSON width GET "${first}" width)
if(NOT width EQUAL 16)
    message(FATAL_ERROR "Generated config ignored project defaults")
endif()
if(EXISTS "${project}/Assets/Sprites/plain.config")
    message(FATAL_ERROR "Unprefixed asset received an unwanted config")
endif()
file(READ "${project}/Assets/Sprites/anim_preserve.config" preserved)
if(NOT preserved STREQUAL "invalid-but-owned")
    message(FATAL_ERROR "Existing invalid config was changed")
endif()
file(WRITE "${project}/project.config" "{\"sprite\":{\"width\":64}}")
execute_process(COMMAND "${TOOL}" "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Second generation failed")
endif()
file(READ "${config}" second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "Existing generated config was overwritten")
endif()
message(STATUS "Config authoring passed; fixture retained at ${project}")