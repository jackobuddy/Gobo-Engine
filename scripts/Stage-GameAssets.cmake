cmake_minimum_required(VERSION 3.28)
foreach(name GOBO_ASSETS GOBO_RUNTIME GOBO_BUILD_ROOT GOBO_ENGINE)
    if(NOT DEFINED ${name} OR "${${name}}" STREQUAL "")
        message(FATAL_ERROR "Missing staging argument: ${name}")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${GOBO_ASSETS}")
    message(FATAL_ERROR "Project Assets directory is missing: ${GOBO_ASSETS}")
endif()
if(NOT EXISTS "${GOBO_BUILD_ROOT}/CMakeCache.txt")
    message(FATAL_ERROR "Staging requires a configured build directory")
endif()
file(REAL_PATH "${GOBO_BUILD_ROOT}" buildRoot)
file(MAKE_DIRECTORY "${GOBO_RUNTIME}")
file(REAL_PATH "${GOBO_RUNTIME}" runtime)
file(REAL_PATH "${GOBO_ASSETS}" sourceAssets)
cmake_path(IS_PREFIX buildRoot "${runtime}" NORMALIZE insideBuild)
cmake_path(IS_PREFIX sourceAssets "${runtime}" NORMALIZE insideSource)
if(NOT insideBuild OR insideSource)
    message(FATAL_ERROR "Unsafe runtime asset staging path: ${runtime}")
endif()
# Only replace this generated copy, never the project's source Assets.
set(destination "${runtime}/Assets")
cmake_path(IS_PREFIX destination "${sourceAssets}" NORMALIZE sourceInDestination)
if(sourceInDestination)
    message(FATAL_ERROR "Refusing to replace source assets during staging")
endif()
if(EXISTS "${destination}")
    file(REAL_PATH "${destination}" existing)
    if(NOT "${existing}" STREQUAL "${destination}")
        message(FATAL_ERROR "Runtime Assets must not be a directory link")
    endif()
endif()
file(REMOVE_RECURSE "${destination}")
file(MAKE_DIRECTORY "${destination}")
file(COPY "${sourceAssets}/" DESTINATION "${destination}")
file(MAKE_DIRECTORY "${runtime}/licenses/Roboto")
configure_file("${GOBO_ENGINE}/assets/fonts/Roboto/OFL.txt"
    "${runtime}/licenses/Roboto/OFL.txt" COPYONLY)